# Chrome, chromedriver and Lightpanda install here via @puppeteer/browsers
.browsers/
# npm install rebuilds this
node_modules/
# throwaway Chrome user-data-dirs created by lib/chrome.js
.run/
# never commit credentials; every probe reads GL_TOKEN from the environment
.env
.env.*
# written by bench.mjs on every run; the evidence the guide cites is in results/
bench-results.json
